generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  STUDENT
  CONSULTANT // Preserved to match PostgreSQL DB; not actively assigned — zero users hold this role
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ArticleCategory {
  UNIVERSITIES
  ADMISSIONS
  SCHOLARSHIPS
  VISA
  STUDENT_LIFE
  CAREER
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ScholarshipType {
  FULLY_FUNDED
  PARTIAL
  TUITION_WAIVER
}

enum ImmigrationDeadlineType {
  VISA
  IMMIGRATION
  APPLICATION
  REGISTRATION
  POLICY
  SCHOLARSHIP
}

enum DeadlineStatus {
  UPCOMING
  CLOSING_SOON
  PASSED
  UPDATED
}

enum DeadlineImportance {
  CRITICAL
  HIGH
  MEDIUM
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  role      UserRole   @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Password lifecycle — invited staff must set their own password before access
  mustChangePassword Boolean @default(false)

  // Relations
  studentProfile StudentProfile?
  sessions       UserSession[]
}

// ============================================================
// OPAQUE SESSIONS
// ============================================================

/// Server-side session store. The browser only ever holds the raw opaque
/// token in a host-only HttpOnly cookie; only its HMAC-SHA-256 hash is
/// persisted here, so a database disclosure cannot be replayed as a session.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// STUDENT PROFILES & PREFERENCES
// ============================================================

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCountries String[] // Array of country IDs, e.g. ["canada", "uk", "germany"]
  studyLevel      String? // "Bachelors" | "Masters" | "PhD" | "Diploma"
  degree          String? // e.g. "Computer Science"
  branch          String? // e.g. "Artificial Intelligence"
  preferredIntake String? // e.g. "Fall 2027"
  budgetRange     String? // e.g. "$20,000 - $35,000"
  interests       String[] // e.g. ["SCHOLARSHIPS", "VISA", "ADMISSIONS"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// GEOGRAPHY / DESTINATIONS
// ============================================================

model Country {
  id                String   @id // e.g. "canada", "uk", "usa", "australia", "germany", "ireland", "netherlands", "france"
  name              String   @unique
  code              String // e.g. "CA", "GB", "US", "AU", "DE", "IE", "NL", "FR"
  flag              String // Emoji e.g. "🇨🇦"
  universitiesCount Int      @default(0)
  averageTuition    String // e.g. "CAD 28,500 / yr"
  popularIntake     String // e.g. "September"
  updatesCount      Int      @default(0)
  heroImage         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  universities           University[]
  articles               ArticleCountry[]
  primaryArticles        Article[]                @relation("PrimaryCountry")
  scholarships           ScholarshipHostCountry[]
  immigrationDeadlines   ImmigrationDeadline[]
  rssSources             RSSSource[]
  contentSources         ContentSource[]
  consultantsHQ          Consultant[]             @relation("ConsultantHQ")
  consultantDestinations ConsultantDestination[]
}

// ============================================================
// EDITORIAL & NEWS
// ============================================================

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  headline    String
  summary     String          @db.Text
  content     String?         @db.Text
  category    ArticleCategory
  readingTime String          @default("4 min read")
  image       String?
  status      ArticleStatus   @default(DRAFT)
  breaking    Boolean         @default(false)
  featured    Boolean         @default(false)
  isRss       Boolean         @default(false)
  sourceUrl   String?         @unique
  sourceName  String?
  publishedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Country Relations
  primaryCountryId String?
  primaryCountry   Country?         @relation("PrimaryCountry", fields: [primaryCountryId], references: [id])
  countries        ArticleCountry[]

  // RSS Relation
  rssSourceId String?
  rssSource   RSSSource? @relation(fields: [rssSourceId], references: [id])

  // Ingestion Relations
  sourceLinks ArticleSourceLink[]
  candidates  ArticleCandidate[]

  @@index([status, publishedAt])
  @@index([primaryCountryId, publishedAt])
  @@index([rssSourceId])
}

model ArticleCountry {
  articleId String
  countryId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([articleId, countryId])
}

// ============================================================
// UNIVERSITIES & INTAKES
// ============================================================

model University {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  initials     String
  countryId    String
  country      Country  @relation(fields: [countryId], references: [id])
  city         String
  ranking      Int
  tuition      String
  tuitionValue Float
  courses      String[]
  scholarships Boolean  @default(true)
  intake       String   @default("September 2027")
  degree       String   @default("Both") // "Bachelors" | "Masters" | "Both"
  ielts        String   @default("6.5")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  intakes             UniversityIntake[]
  awardedScholarships Scholarship[]

  @@index([countryId])
}

model UniversityIntake {
  id                  String     @id @default(cuid())
  universityId        String
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  term                String // e.g. "Fall 2027", "Winter 2027", "Semester 1"
  applicationDeadline DateTime?
  documentDeadline    DateTime?
  depositDeadline     DateTime?
  isRolling           Boolean    @default(false)
  status              String     @default("Open") // "Open", "Closing Soon", "Closed"
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([universityId, term])
}

// ============================================================
// SCHOLARSHIPS
// ============================================================

model Scholarship {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  organization   String
  funding        String
  degree         String
  deadline       DateTime?
  deadlineString String // e.g. "30 September 2026"
  eligibility    String          @db.Text
  type           ScholarshipType
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Optional University link
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  // Multi-country destinations
  destinations ScholarshipHostCountry[]
}

model ScholarshipHostCountry {
  scholarshipId String
  countryId     String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  country       Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([scholarshipId, countryId])
}

// ============================================================
// IMMIGRATION & POLICY TRACKER
// ============================================================

model ImmigrationDeadline {
  id                  String                  @id // e.g. "ca-pal-fall-2026"
  slug                String                  @unique
  title               String
  countryId           String
  country             Country                 @relation(fields: [countryId], references: [id])
  deadlineDate        DateTime
  deadlineType        ImmigrationDeadlineType
  status              DeadlineStatus
  importance          DeadlineImportance
  description         String                  @db.Text
  source              String
  lastUpdated         String
  relatedArticleTitle String?
  relatedArticleHref  String?
  applicationUrl      String?
  tags                String[]
  content             String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([countryId, deadlineDate])
}

// ============================================================
// RSS SOURCE REGISTRY
// ============================================================

model RSSSource {
  id             String          @id // e.g. "ircc-canada", "ukvi"
  name           String
  countryId      String? // Nullable for multi-country / global sources
  country        Country?        @relation(fields: [countryId], references: [id])
  category       ArticleCategory @default(VISA)
  sourceType     String          @default("government") // "government" | "university" | "news"
  feedUrl        String
  enabled        Boolean         @default(true)
  disabledReason String?         @db.Text
  slugPrefix     String
  fallbackImage  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  articles Article[]
}

// ============================================================
// PARTNERS & CONSULTANTS
// ============================================================

model Consultant {
  id          String   @id // e.g. "global-pathways-education"
  name        String
  slug        String   @unique
  logo        String
  description String   @db.Text
  countryId   String // Headquarter Country
  country     Country  @relation("ConsultantHQ", fields: [countryId], references: [id])
  cities      String[]
  services    String[]
  website     String
  email       String
  phone       String
  verified    Boolean  @default(false)
  featured    Boolean  @default(false)
  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  established String
  address     String
  categories  String[]
  sponsored   Boolean  @default(false)
  lastUpdated String
  aboutHtml   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations ConsultantDestination[]
}

model ConsultantDestination {
  consultantId String
  countryId    String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  country      Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([consultantId, countryId])
}

// ============================================================
// INGESTION ENGINE ENUMS
// ============================================================

enum SourceType {
  API
  ATOM
  RSS
  WEB
  WATCH
  DATA
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  STALE
  BROKEN
  RATE_LIMITED
}

enum SourceRunType {
  LIVE
  BACKFILL
  RECONCILE
  MANUAL
}

enum SourceRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ProcessingStatus {
  DISCOVERED
  DETAIL_PENDING
  ENRICHED
  NORMALIZED
  VERSIONED
  SCORED
  CLASSIFIED
  ROUTED
  IMPORTED
  PUBLISHED
}

enum RoutingDecision {
  IGNORE
  REVIEW
  CREATE_DRAFT
  PUBLISH
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_DRAFTED
  DRAFT_CREATED
  IGNORED
}

enum SourceLinkType {
  PRIMARY_SOURCE
  REFERENCE
  CORROBORATING
}

enum BackfillStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum WindowStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// INGESTION ENGINE MODELS
// ============================================================

model ContentSource {
  id             String             @id @default(cuid())
  code           String             @unique // e.g. "CA_IRCC_ATOM", "UK_GOVUK_SEARCH"
  name           String
  countryId      String?
  country        Country?           @relation(fields: [countryId], references: [id])
  sourceType     SourceType         @default(RSS)
  baseUrl        String
  feedUrl        String?
  enabled        Boolean            @default(true)
  disabledReason String?            @db.Text
  config         Json?
  schedule       String?            // cron or interval string
  categoryHint   ArticleCategory?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  syncState      SourceSyncState?
  runs           SourceRun[]
  items          SourceItem[]
  backfillRuns   BackfillRun[]

  @@index([countryId])
  @@index([sourceType, enabled])
}

model SourceSyncState {
  id                  String             @id @default(cuid())
  contentSourceId     String             @unique
  contentSource       ContentSource      @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  cursor              String?
  watermark           DateTime?
  etag                String?
  lastModified        String?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorMessage    String?            @db.Text
  consecutiveFailures Int                @default(0)
  healthStatus        SourceHealthStatus @default(HEALTHY)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model SourceRun {
  id              String          @id @default(cuid())
  contentSourceId String
  contentSource   ContentSource   @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  runType         SourceRunType   @default(LIVE)
  status          SourceRunStatus @default(RUNNING)
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  itemsFound      Int             @default(0)
  itemsCreated    Int             @default(0)
  itemsUpdated    Int             @default(0)
  itemsFailed     Int             @default(0)
  errorMessage    String?         @db.Text
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([contentSourceId, startedAt, status])
}

model SourceItem {
  id               String                  @id @default(cuid())
  contentSourceId  String
  contentSource    ContentSource           @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  externalId       String?
  canonicalUrl     String
  canonicalUrlHash String
  title            String
  summary          String?                 @db.Text
  publishedAt      DateTime?
  discoveredAt     DateTime                @default(now())
  processingStatus ProcessingStatus        @default(DISCOVERED)
  countryId        String?
  language         String?                 @default("en")
  nativeTopics     String[]
  rawMetadata      Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  versions         SourceDocumentVersion[]
  assessments      AiAssessment[]
  candidate        ArticleCandidate?
  articleLinks     ArticleSourceLink[]

  @@unique([contentSourceId, externalId])
  @@unique([contentSourceId, canonicalUrlHash])
  @@index([publishedAt])
  @@index([countryId, contentSourceId])
  @@index([processingStatus])
}

model SourceDocumentVersion {
  id             String              @id @default(cuid())
  sourceItemId   String
  sourceItem     SourceItem          @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  contentHash    String
  rawBody        String?             @db.Text
  cleanHtml      String?             @db.Text
  cleanText      String?             @db.Text
  title          String?
  authors        String[]
  versionNumber  Int                 @default(1)
  httpStatus     Int?
  capturedAt     DateTime            @default(now())

  // Relations
  diffsFromPrior SourceDiff[]        @relation("PriorVersion")
  diffsToNext    SourceDiff[]        @relation("NextVersion")
  assessments    AiAssessment[]
  articleLinks   ArticleSourceLink[]

  @@unique([sourceItemId, contentHash])
  @@index([sourceItemId, capturedAt])
}

model SourceDiff {
  id             String                @id @default(cuid())
  sourceItemId   String
  priorVersionId String
  priorVersion   SourceDocumentVersion @relation("PriorVersion", fields: [priorVersionId], references: [id], onDelete: Cascade)
  nextVersionId  String
  nextVersion    SourceDocumentVersion @relation("NextVersion", fields: [nextVersionId], references: [id], onDelete: Cascade)
  isMaterial     Boolean               @default(false)
  changeSummary  String?               @db.Text
  addedTokens    Int                   @default(0)
  removedTokens  Int                   @default(0)
  patch          String?               @db.Text
  detectedAt     DateTime              @default(now())

  @@index([sourceItemId, detectedAt])
}

model AiAssessment {
  id                String                 @id @default(cuid())
  sourceItemId      String
  sourceItem        SourceItem             @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  versionId         String?
  version           SourceDocumentVersion? @relation(fields: [versionId], references: [id])
  relevanceScore    Float
  confidenceScore   Float
  urgency           String?
  internalCategory  String
  suggestedCategory ArticleCategory?
  routingDecision   RoutingDecision        @default(REVIEW)
  suggestedHeadline String?
  suggestedSummary  String?                @db.Text
  suggestedContent  String?                @db.Text
  keyTakeaways      String[]
  targetAudience    String[]
  model             String
  promptVersion     String
  rawOutput         Json?
  createdAt         DateTime               @default(now())

  // Relations
  candidate         ArticleCandidate?

  @@index([sourceItemId, createdAt])
  @@index([routingDecision])
}

model ArticleCandidate {
  id               String           @id @default(cuid())
  sourceItemId     String           @unique
  sourceItem       SourceItem       @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  aiAssessmentId   String?          @unique
  aiAssessment     AiAssessment?    @relation(fields: [aiAssessmentId], references: [id])
  headline         String
  summary          String           @db.Text
  content          String?          @db.Text
  category         ArticleCategory  @default(VISA)
  primaryCountryId String?
  confidence       Float            @default(0.0)
  status           CandidateStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  articleId        String?
  article          Article?         @relation(fields: [articleId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([primaryCountryId])
}

model ArticleSourceLink {
  id           String                 @id @default(cuid())
  articleId    String
  article      Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sourceItemId String
  sourceItem   SourceItem             @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  versionId    String?
  version      SourceDocumentVersion? @relation(fields: [versionId], references: [id])
  linkType     SourceLinkType         @default(PRIMARY_SOURCE)
  createdAt    DateTime               @default(now())

  @@unique([articleId, sourceItemId])
  @@index([sourceItemId])
}

model BackfillRun {
  id               String           @id @default(cuid())
  contentSourceId  String
  contentSource    ContentSource    @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  status           BackfillStatus   @default(PENDING)
  totalWindows     Int              @default(0)
  completedWindows Int              @default(0)
  failedWindows    Int              @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  config           Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  windows          BackfillWindow[]

  @@index([contentSourceId, status])
}

model BackfillWindow {
  id            String         @id @default(cuid())
  backfillRunId String
  backfillRun   BackfillRun    @relation(fields: [backfillRunId], references: [id], onDelete: Cascade)
  windowStart   DateTime
  windowEnd     DateTime
  cursor        String?
  pageNumber    Int?
  status        WindowStatus   @default(PENDING)
  itemsFound    Int            @default(0)
  attempts      Int            @default(0)
  lastError     String?        @db.Text
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([backfillRunId, windowStart, windowEnd])
  @@index([backfillRunId, status])
}

